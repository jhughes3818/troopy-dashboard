generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model TelemetryReading {
  id         String   @id @default(cuid())
  deviceId   String
  voltage    Float?
  current    Float?
  soc        Float?
  power      Float?
  auxVoltage Float?
  ttgDays    Float?
  insideTempC  Float?
  outsideTempC Float?
  fridgeTempC  Float?
  gpsValid    Boolean?
  gpsLatitude Float?
  gpsLongitude Float?
  gpsAltitudeM Float?
  gpsSpeedKmph Float?
  gpsCourseDeg Float?
  gpsSatellites Float?
  gpsHdop Float?
  gpsFixAgeMs Float?
  waterCumulativeMl Float?
  waterFlowMlMin    Float?
  timestampMs BigInt
  receivedAt DateTime @default(now())

  @@index([receivedAt(sort: Desc)])
  @@index([deviceId, receivedAt(sort: Desc)])
  @@unique([deviceId, timestampMs])
}

model TelemetryHourly {
  id                String   @id @default(cuid())
  deviceId          String
  hourBucket        DateTime // UTC, truncated to start of hour

  voltage           Float?
  current           Float?
  soc               Float?
  power             Float?
  auxVoltage        Float?
  ttgDays           Float?
  insideTempC       Float?
  outsideTempC      Float?
  fridgeTempC       Float?
  gpsLatitude       Float?
  gpsLongitude      Float?
  gpsSpeedKmph      Float?
  waterFlowMlMin    Float?

  socMin            Float?
  voltageMin        Float?

  waterCumulativeMl Float?

  sampleCount       Int

  @@unique([deviceId, hourBucket])
  @@index([deviceId, hourBucket(sort: Desc)])
}

model FuelLog {
  id               String   @id @default(cuid())
  filledAt         DateTime
  litres           Float
  isFull           Boolean  @default(false)
  distanceKm       Float?
  gpsDistanceKm    Float?
  pricePerL        Float?
  notes            String?
  createdAt        DateTime @default(now())

  @@index([filledAt(sort: Asc)])
}

model VehicleProfile {
  id            String  @id @default("vehicle")
  tankCapacityL Float
}

model WaterLog {
  id              String   @id @default(cuid())
  filledAt        DateTime
  notes           String?
  waterSnapshotMl Float?
  createdAt       DateTime @default(now())

  @@index([filledAt(sort: Asc)])
}
